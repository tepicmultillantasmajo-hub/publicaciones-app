# ===== Obligatorias =====
# Clave para cifrar los tokens de Meta (mínimo 32 caracteres). NO la cambies después: los tokens guardados dejarían de leerse.
APP_ENCRYPTION_KEY=
# Secreto compartido con el webhook de n8n (mínimo 16 caracteres). El mismo valor va en n8n.
N8N_WEBHOOK_SECRET=
# Cloudinary (Configuración > API Keys). Se usa subida firmada; el secreto nunca llega al navegador.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Primer administrador (solo se usa si todavía no existe ninguno). Se pedirá cambiar la contraseña al entrar.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===== Opcionales =====
APP_NAME=Centro de Publicaciones
APP_URL=https://publicaciones.ejemplo.com
APP_TIMEZONE=America/Mazatlan
N8N_WEBHOOK_URL=http://n8n:5678/webhook/motor-publicacion
N8N_TIMEOUT_MIN=15
MAX_PUBLICACIONES_SIMULTANEAS=2
CLOUDINARY_FOLDER=publicaciones
MAX_IMAGEN_MB=8
MAX_VIDEO_MB=100
SESION_HORAS=12
# Solo para pruebas locales sin HTTPS:
# COOKIE_SECURE=false
